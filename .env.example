# Copy this file to .env. Docker Compose reads .env automatically.
# .env is gitignored, so real secrets never get committed.

# PostgreSQL (local development values)
POSTGRES_USER=receipts
POSTGRES_PASSWORD=receipts
POSTGRES_DB=receipts

# Anthropic API key for the receipt extraction step (Phase 4).
# Get one at https://console.anthropic.com and paste it after the = sign in .env.
ANTHROPIC_API_KEY=

# Which Claude model reads the receipts. claude-haiku-5-5 is cheap and fast;
# claude-opus-5-5 is the most capable and costs much more.
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: connect a pretend bank through Plaid's SANDBOX and import its
# pretend transactions. Sign up free at https://dashboard.plaid.com, open
# Developers > Keys, and paste the client id and the *Sandbox* secret here.
# The app only ever talks to the sandbox, never to real bank accounts.
PLAID_CLIENT_ID=
PLAID_SECRET=

# Optional: to use the app from a phone on the same Wi-Fi, put this computer's
# network address here with port 3000 (find the address with `ipconfig`),
# then run `docker compose up -d`. Leave it empty to use this computer only.
# Example: PHONE_ORIGIN=http://192.168.1.20:3000
PHONE_ORIGIN=
