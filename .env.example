# Copy this file to .env. Docker Compose reads .env automatically.
# .env is gitignored, so real secrets never get committed.

# PostgreSQL (local development values)
POSTGRES_USER=receipts
POSTGRES_PASSWORD=receipts
POSTGRES_DB=receipts

# Anthropic API key for the receipt extraction step (Phase 4).
# Get one at https://console.anthropic.com and paste it after the = sign in .env.
ANTHROPIC_API_KEY=

# Which Claude model reads the receipts. claude-haiku-5-5 is cheap and fast;
# claude-opus-5-5 is the most capable and costs much more.
ANTHROPIC_MODEL=claude-haiku-5-5
